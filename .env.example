PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/apex_store
JWT_SECRET=change_this_to_a_long_random_string_before_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Razorpay Test Credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
